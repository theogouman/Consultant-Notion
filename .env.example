# --- Notion (server-only, ne jamais exposer côté client) ---
# Token de l'intégration Notion. À enregistrer dans les variables
# d'environnement Vercel. Ne jamais committer sa valeur réelle.
NOTION_API_TOKEN=

# ID de la base Notion des études de cas.
# Valeur par défaut si non renseignée : a9a77a8e49af4c83bb6c3cfc67706b20
NOTION_CASE_STUDIES_DATABASE_ID=a9a77a8e49af4c83bb6c3cfc67706b20

# --- Public ---
# URL de prise de rendez-vous (destination finale du formulaire de qualification).
# [À AFFINER] — renseigner le vrai lien de booking.
NEXT_PUBLIC_BOOKING_URL=https://cal.com/theo-gouman
