# ==========================================================================
# Variables d'environnement — consultant-notion.fr
# Aucun secret en dur : tout passe par les variables Vercel.
# Ne jamais committer de valeur réelle.
# ==========================================================================

# --- Notion (server-only, ne jamais exposer côté client) ---
# Token de l'intégration Notion.
NOTION_API_TOKEN=

# ID de la base Notion des études de cas.
# Valeur par défaut si non renseignée : a9a77a8e49af4c83bb6c3cfc67706b20
NOTION_CASE_STUDIES_DATABASE_ID=a9a77a8e49af4c83bb6c3cfc67706b20

# ==========================================================================
# Booker maison (module src/modules/booking/)
# ==========================================================================

# --- Public ---
# URL de base publique (construction des liens manage + add-to-calendar).
NEXT_PUBLIC_BASE_URL=https://consultant-notion.fr

# --- Google Calendar (app OAuth2 existante et approuvée de Théo) ---
# ⚠️ App OAuth en statut Production (sinon le refresh token expire à 7 jours),
#    scopes Calendar (events + freebusy) autorisés, URI de redirection configurée.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=theo@gouman.fr

# --- Supabase (base de données uniquement, server-only) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (100 % des e-mails lead + notifications internes) ---
RESEND_API_KEY=

# --- Admin (/admin) ---
# Mot de passe d'accès + secret de signature du cookie de session.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- Cron rappel H-3 ---
# Secret partagé avec le job pg_cron Supabase (en-tête x-cron-secret).
CRON_SECRET=
